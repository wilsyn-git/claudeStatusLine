{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/wilsyn-git/claudeStatusLine/main/statusLine.schema.json",
  "title": "claudeStatusLine config",
  "description": "Layout and options for claudeStatusLine. Every key is optional and merges over the built-in defaults.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "handoffPct": {
      "description": "Context percentage at which to hand off to a fresh session. The HANDOFF_PCT env var overrides it.",
      "default": 60,
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "warnBelow": {
      "description": "Context turns yellow this many points below handoffPct.",
      "default": 15,
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "separator": {
      "description": "Text between segments.",
      "default": " │ ",
      "type": "string"
    },
    "lines": {
      "description": "One list per output line, naming segments in order. An entry is a segment id, or {\"id\": ..., options} to override options in that one place.",
      "default": [
        [
          "model",
          "context",
          "handoff",
          "tokens"
        ],
        [
          "cache",
          "limits",
          "cost",
          "git"
        ]
      ],
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "enum": [
                "model",
                "context",
                "handoff",
                "tokens",
                "cache",
                "limits",
                "cost",
                "git",
                "dir",
                "session",
                "pr",
                "vim",
                "agent",
                "duration",
                "clock",
                "command",
                "text"
              ],
              "description": "A segment id"
            },
            {
              "type": "object",
              "description": "Model name colored by family, reasoning effort, and a bolt when fast mode is on. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "model"
                },
                "effort": {
                  "description": "Show the reasoning effort level.",
                  "default": true,
                  "type": "boolean"
                },
                "fast": {
                  "description": "Show a bolt when fast mode is on.",
                  "default": true,
                  "type": "boolean"
                },
                "thinking": {
                  "description": "Show a lightbulb when extended thinking is on.",
                  "default": false,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Context used vs. window size; yellow near the handoff target, red past it. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "context"
                },
                "barCells": {
                  "description": "Width of the bar in cells.",
                  "default": 10,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40
                },
                "turnDelta": {
                  "description": "Show this turn's context growth (+N).",
                  "default": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Tokens left before the handoff target, or \"handoff now\" once past it. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "handoff"
                },
                "turnEstimate": {
                  "description": "Estimate turns left from the average growth of recent turns.",
                  "default": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Last request: newly processed input, output, and cache read. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "tokens"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Prompt cache time left (or cold plus the tokens a re-cache would bill), hit ratio, misses. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "cache"
                },
                "hitRatio": {
                  "description": "Show the cache hit ratio.",
                  "default": true,
                  "type": "boolean"
                },
                "misses": {
                  "description": "Show the cache miss count.",
                  "default": true,
                  "type": "boolean"
                },
                "missCause": {
                  "description": "Show the likely cause of the last miss, such as tools changed.",
                  "default": false,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Plan usage for the 5-hour and weekly windows, and the spend limit if your plan has one. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "limits"
                },
                "windows": {
                  "description": "Which windows to show, in order. spend shows dollars used against a spend limit.",
                  "default": [
                    "5h",
                    "wk"
                  ],
                  "type": "array",
                  "items": {
                    "enum": [
                      "5h",
                      "wk",
                      "spend"
                    ]
                  },
                  "uniqueItems": true
                },
                "showResetAbove": {
                  "description": "Show the reset countdown at or above this percentage.",
                  "default": 50,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "warn": {
                  "description": "Yellow at or above this percentage.",
                  "default": 50,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "bad": {
                  "description": "Red at or above this percentage.",
                  "default": 80,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Session cost and burn rate per hour. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "cost"
                },
                "burnRate": {
                  "description": "Show the burn rate per hour.",
                  "default": true,
                  "type": "boolean"
                },
                "burnRateAfterMin": {
                  "description": "Minutes into the session before the burn rate appears.",
                  "default": 5,
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Branch, dirty file count, ahead/behind, and lines added/removed this session. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "git"
                },
                "lineDelta": {
                  "description": "Show lines added/removed this session.",
                  "default": true,
                  "type": "boolean"
                },
                "worktree": {
                  "description": "Show the worktree name when in a linked git worktree.",
                  "default": false,
                  "type": "boolean"
                },
                "repo": {
                  "description": "Show the repository owner/name before the branch.",
                  "default": false,
                  "type": "boolean"
                },
                "timeoutMs": {
                  "description": "Give up on git after this many milliseconds.",
                  "default": 500,
                  "type": "integer",
                  "minimum": 50,
                  "maximum": 5000
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Current folder, marked when it differs from where the session started, plus a count of added folders. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "dir"
                },
                "style": {
                  "description": "short: ~ and the last two folders; name: the folder name only; full: the whole path.",
                  "default": "short",
                  "type": "string",
                  "enum": [
                    "short",
                    "name",
                    "full"
                  ]
                },
                "projectDir": {
                  "description": "Show the folder the session started in when it differs.",
                  "default": true,
                  "type": "boolean"
                },
                "addedDirs": {
                  "description": "Show how many folders were added with /add-dir.",
                  "default": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Session name, from --name, /rename, or the generated title. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "session"
                },
                "maxLength": {
                  "description": "Shorten names longer than this.",
                  "default": 30,
                  "type": "integer",
                  "minimum": 4,
                  "maximum": 80
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Open pull request (or GitLab merge request) for the branch, colored by review state. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "pr"
                },
                "state": {
                  "description": "Show the review state.",
                  "default": true,
                  "type": "boolean"
                },
                "link": {
                  "description": "Make the number a clickable link in terminals that support it.",
                  "default": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Vim mode when vim mode is on. Set hideVimModeIndicator in settings.json so it is not shown twice. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "vim"
                },
                "short": {
                  "description": "Show one or two letters (N, I, V, VL) instead of the full mode.",
                  "default": false,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Agent name when running with --agent, and the output style when it isn't the default. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "agent"
                },
                "outputStyle": {
                  "description": "Show a non-default output style.",
                  "default": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Session time, and how much of it was spent waiting on the API. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "duration"
                },
                "apiShare": {
                  "description": "Show the share of time spent waiting on the API.",
                  "default": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Local time. While the session is idle it only updates if refreshInterval is set in the statusLine settings. Options set here apply to this placement only.",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "clock"
                },
                "format": {
                  "description": "Clock format.",
                  "default": "24h",
                  "type": "string",
                  "enum": [
                    "24h",
                    "12h"
                  ]
                },
                "seconds": {
                  "description": "Show seconds.",
                  "default": false,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "First line of output from a shell command, run in the session directory. Can be used more than once. Options set here apply to this placement only.",
              "required": [
                "id",
                "cmd"
              ],
              "properties": {
                "id": {
                  "const": "command"
                },
                "cmd": {
                  "description": "Shell command to run.",
                  "type": "string"
                },
                "icon": {
                  "description": "Text shown before the output.",
                  "type": "string"
                },
                "color": {
                  "description": "Palette name or #rrggbb.",
                  "default": "fg",
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "fg",
                        "dim",
                        "blue",
                        "cyan",
                        "purple",
                        "green",
                        "yellow",
                        "orange",
                        "red",
                        "teal",
                        "magenta"
                      ]
                    },
                    {
                      "pattern": "^#[0-9a-fA-F]{6}$",
                      "format": "color-hex"
                    },
                    {
                      "description": "A name defined under \"colors\""
                    }
                  ]
                },
                "timeoutMs": {
                  "description": "Give up on the command after this many milliseconds.",
                  "default": 300,
                  "type": "integer",
                  "minimum": 50,
                  "maximum": 5000
                },
                "cacheSec": {
                  "description": "Reuse the last result (including a failure) for this many seconds.",
                  "default": 30,
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "Fixed text, such as a label or a spacer. Can be used more than once. Options set here apply to this placement only.",
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "const": "text"
                },
                "text": {
                  "description": "Text to show.",
                  "type": "string"
                },
                "color": {
                  "description": "Palette name or #rrggbb.",
                  "default": "dim",
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "fg",
                        "dim",
                        "blue",
                        "cyan",
                        "purple",
                        "green",
                        "yellow",
                        "orange",
                        "red",
                        "teal",
                        "magenta"
                      ]
                    },
                    {
                      "pattern": "^#[0-9a-fA-F]{6}$",
                      "format": "color-hex"
                    },
                    {
                      "description": "A name defined under \"colors\""
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "segments": {
      "description": "Default options per segment id.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "description": "Model name colored by family, reasoning effort, and a bolt when fast mode is on.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "effort": {
              "description": "Show the reasoning effort level.",
              "default": true,
              "type": "boolean"
            },
            "fast": {
              "description": "Show a bolt when fast mode is on.",
              "default": true,
              "type": "boolean"
            },
            "thinking": {
              "description": "Show a lightbulb when extended thinking is on.",
              "default": false,
              "type": "boolean"
            }
          }
        },
        "context": {
          "description": "Context used vs. window size; yellow near the handoff target, red past it.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "barCells": {
              "description": "Width of the bar in cells.",
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            },
            "turnDelta": {
              "description": "Show this turn's context growth (+N).",
              "default": true,
              "type": "boolean"
            }
          }
        },
        "handoff": {
          "description": "Tokens left before the handoff target, or \"handoff now\" once past it.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "turnEstimate": {
              "description": "Estimate turns left from the average growth of recent turns.",
              "default": true,
              "type": "boolean"
            }
          }
        },
        "tokens": {
          "description": "Last request: newly processed input, output, and cache read.",
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "cache": {
          "description": "Prompt cache time left (or cold plus the tokens a re-cache would bill), hit ratio, misses.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hitRatio": {
              "description": "Show the cache hit ratio.",
              "default": true,
              "type": "boolean"
            },
            "misses": {
              "description": "Show the cache miss count.",
              "default": true,
              "type": "boolean"
            },
            "missCause": {
              "description": "Show the likely cause of the last miss, such as tools changed.",
              "default": false,
              "type": "boolean"
            }
          }
        },
        "limits": {
          "description": "Plan usage for the 5-hour and weekly windows, and the spend limit if your plan has one.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "windows": {
              "description": "Which windows to show, in order. spend shows dollars used against a spend limit.",
              "default": [
                "5h",
                "wk"
              ],
              "type": "array",
              "items": {
                "enum": [
                  "5h",
                  "wk",
                  "spend"
                ]
              },
              "uniqueItems": true
            },
            "showResetAbove": {
              "description": "Show the reset countdown at or above this percentage.",
              "default": 50,
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "warn": {
              "description": "Yellow at or above this percentage.",
              "default": 50,
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "bad": {
              "description": "Red at or above this percentage.",
              "default": 80,
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "cost": {
          "description": "Session cost and burn rate per hour.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "burnRate": {
              "description": "Show the burn rate per hour.",
              "default": true,
              "type": "boolean"
            },
            "burnRateAfterMin": {
              "description": "Minutes into the session before the burn rate appears.",
              "default": 5,
              "type": "number",
              "minimum": 0
            }
          }
        },
        "git": {
          "description": "Branch, dirty file count, ahead/behind, and lines added/removed this session.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lineDelta": {
              "description": "Show lines added/removed this session.",
              "default": true,
              "type": "boolean"
            },
            "worktree": {
              "description": "Show the worktree name when in a linked git worktree.",
              "default": false,
              "type": "boolean"
            },
            "repo": {
              "description": "Show the repository owner/name before the branch.",
              "default": false,
              "type": "boolean"
            },
            "timeoutMs": {
              "description": "Give up on git after this many milliseconds.",
              "default": 500,
              "type": "integer",
              "minimum": 50,
              "maximum": 5000
            }
          }
        },
        "dir": {
          "description": "Current folder, marked when it differs from where the session started, plus a count of added folders.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {
              "description": "short: ~ and the last two folders; name: the folder name only; full: the whole path.",
              "default": "short",
              "type": "string",
              "enum": [
                "short",
                "name",
                "full"
              ]
            },
            "projectDir": {
              "description": "Show the folder the session started in when it differs.",
              "default": true,
              "type": "boolean"
            },
            "addedDirs": {
              "description": "Show how many folders were added with /add-dir.",
              "default": true,
              "type": "boolean"
            }
          }
        },
        "session": {
          "description": "Session name, from --name, /rename, or the generated title.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxLength": {
              "description": "Shorten names longer than this.",
              "default": 30,
              "type": "integer",
              "minimum": 4,
              "maximum": 80
            }
          }
        },
        "pr": {
          "description": "Open pull request (or GitLab merge request) for the branch, colored by review state.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "description": "Show the review state.",
              "default": true,
              "type": "boolean"
            },
            "link": {
              "description": "Make the number a clickable link in terminals that support it.",
              "default": true,
              "type": "boolean"
            }
          }
        },
        "vim": {
          "description": "Vim mode when vim mode is on. Set hideVimModeIndicator in settings.json so it is not shown twice.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "short": {
              "description": "Show one or two letters (N, I, V, VL) instead of the full mode.",
              "default": false,
              "type": "boolean"
            }
          }
        },
        "agent": {
          "description": "Agent name when running with --agent, and the output style when it isn't the default.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "outputStyle": {
              "description": "Show a non-default output style.",
              "default": true,
              "type": "boolean"
            }
          }
        },
        "duration": {
          "description": "Session time, and how much of it was spent waiting on the API.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apiShare": {
              "description": "Show the share of time spent waiting on the API.",
              "default": true,
              "type": "boolean"
            }
          }
        },
        "clock": {
          "description": "Local time. While the session is idle it only updates if refreshInterval is set in the statusLine settings.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "description": "Clock format.",
              "default": "24h",
              "type": "string",
              "enum": [
                "24h",
                "12h"
              ]
            },
            "seconds": {
              "description": "Show seconds.",
              "default": false,
              "type": "boolean"
            }
          }
        },
        "command": {
          "description": "First line of output from a shell command, run in the session directory. Can be used more than once.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cmd": {
              "description": "Shell command to run.",
              "type": "string"
            },
            "icon": {
              "description": "Text shown before the output.",
              "type": "string"
            },
            "color": {
              "description": "Palette name or #rrggbb.",
              "default": "fg",
              "type": "string",
              "anyOf": [
                {
                  "enum": [
                    "fg",
                    "dim",
                    "blue",
                    "cyan",
                    "purple",
                    "green",
                    "yellow",
                    "orange",
                    "red",
                    "teal",
                    "magenta"
                  ]
                },
                {
                  "pattern": "^#[0-9a-fA-F]{6}$",
                  "format": "color-hex"
                },
                {
                  "description": "A name defined under \"colors\""
                }
              ]
            },
            "timeoutMs": {
              "description": "Give up on the command after this many milliseconds.",
              "default": 300,
              "type": "integer",
              "minimum": 50,
              "maximum": 5000
            },
            "cacheSec": {
              "description": "Reuse the last result (including a failure) for this many seconds.",
              "default": 30,
              "type": "number",
              "minimum": 0
            }
          }
        },
        "text": {
          "description": "Fixed text, such as a label or a spacer. Can be used more than once.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "description": "Text to show.",
              "type": "string"
            },
            "color": {
              "description": "Palette name or #rrggbb.",
              "default": "dim",
              "type": "string",
              "anyOf": [
                {
                  "enum": [
                    "fg",
                    "dim",
                    "blue",
                    "cyan",
                    "purple",
                    "green",
                    "yellow",
                    "orange",
                    "red",
                    "teal",
                    "magenta"
                  ]
                },
                {
                  "pattern": "^#[0-9a-fA-F]{6}$",
                  "format": "color-hex"
                },
                {
                  "description": "A name defined under \"colors\""
                }
              ]
            }
          }
        }
      }
    },
    "colors": {
      "description": "Palette overrides as #rrggbb. New names can be used as a command segment color.",
      "type": "object",
      "properties": {
